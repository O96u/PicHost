# PicHost 环境变量
# 本地开发：复制为 .env 后 npm run dev，首次访问按 /setup 引导创建管理员即可
# 生产环境：docker-compose.yml 中配置，或挂载 /data 后首次访问 Web 引导

# 外部脚本上传 Token（Twikoo / 油猴 / 博客用，可选）
# 请求头：Auth-Token: <token>（表单上传仍可用 token 字段）
# 未配置时可在后台「API」页生成
# API_UPLOAD_TOKEN=

# 防盗链白名单：允许引用图片的站点域名，逗号分隔（自身域名自动放行）
# 可选；不填可在设置页配置。若在此填写则覆盖后台设置
# ALLOWED_REFERER_HOSTS=example.com,www.example.com

# 管理后台域名（可选；不填则使用当前请求域名，也可在设置页配置）
# SITE_BASE_URL=https://admin.example.com

# 隐藏图片直链中的目录前缀（如 images/2026/08/a.webp → a.webp）
# HIDE_FOLDER_IN_URL=false

# 上传目录按年/月分组（true/date 默认；false/flat 则保存为 images/xxx.webp）
# STORAGE_USE_DATE_PATH=true
# STORAGE_LAYOUT=date

# 图片直链域名（可选；不填则使用当前请求域名，也可在设置页配置）
# IMAGE_BASE_URL=https://pic.example.com

# 图片存储目录（默认 ./data，容器内为 /data）
# DATA_DIR=./data

# 服务端 WebP 压缩质量 1-100（默认 80；也可在设置页配置）
# WEBP_QUALITY=80

# 自动删除超过 N 天的图片（0 表示关闭；也可在设置页配置）
# AUTO_DELETE_DAYS=0

# 仅本地开发：设为 true 可绕过登录验证（跳过 /setup，一般无需开启）
# DEV_BYPASS_ACCESS=false
