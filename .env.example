# ============================================
# PicHost 环境变量（全部在服务端配置）
# 复制为 .env 用于本地开发
# 生产环境在 Cloudflare Pages / Worker 后台配置
# ============================================

# ---------- 管理后台（Pages）----------

# 管理密钥（登录用，必填）
ADMIN_SECRET=your-strong-secret-here

# 图片 CDN 域名（生成直链用，必填）
IMAGE_BASE_URL=https://img.example.com

# 删除图片后调用的 Worker 缓存清理地址
IMAGE_WORKER_PURGE_URL=https://img.example.com/__internal/purge

# 与图片 Worker 共用的内部清理 Token
INTERNAL_PURGE_TOKEN=

# Cloudflare Turnstile 人机验证（可选，两个都配才生效）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 外部脚本上传 Token（油猴 / 博客 / 论坛用，与 ADMIN_SECRET 分开）
# 请求头：Authorization: Bearer <token> 或 X-API-Token: <token>
API_UPLOAD_TOKEN=

# 仅本地开发：设为 true 可绕过登录验证
DEV_BYPASS_ACCESS=false

# ---------- 图片 Worker（workers/image-proxy）----------
# 在 Worker Dashboard → 变量和密钥 中配置（勿写入 wrangler.jsonc vars，避免 deploy 覆盖）：
# ALLOWED_REFERER_HOSTS=example.com,www.example.com,pic.example.com
# PUBLIC_IMAGE_ORIGIN=https://img.example.com
# INTERNAL_PURGE_TOKEN 通过 wrangler secret put 设置
